Backup_local.sh 
 
#!/bin/bash 
 
# Kohalik backup tee 
BACKUP_DIR="/srv/minecraft/backups/local" 
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S") 
BACKUP_PATH="$BACKUP_DIR/backup_$TIMESTAMP" 
 
# Loome backup kausta, kui see ei eksisteeri 
mkdir -p $BACKUP_PATH 
 
# Varundame maailmad, serveri faili, logid ja konfiguratsioonifailid 
rsync -av --delete /srv/minecraft/world/ $BACKUP_PATH/world/ 
rsync -av --delete /srv/minecraft/server.jar $BACKUP_PATH/ 
rsync -av --delete /srv/minecraft/mods/ $BACKUP_PATH/mods/ 
rsync -av --delete /srv/minecraft/logs/ $BACKUP_PATH/logs/ 
rsync -av --delete /srv/minecraft/config/ $BACKUP_PATH/config/ 
 
# Logi salvestamine 
echo "Backup completed at $(date)" >> /srv/minecraft/logs/backup_report.log 

